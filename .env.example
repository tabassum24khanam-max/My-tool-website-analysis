# Copy to .env and fill what you have. EVERYTHING is optional —
# missing keys just mean those metrics show "N/A" with a reason.

# Where SQLite DB + screenshots live (Railway: set to /data with a volume)
DATA_DIR=./data

# --- AI mode (only used when the AI toggle is ON) ---
DEEPSEEK_API_KEY=
# optional last-resort fallback, normally leave empty:
OPENAI_API_KEY=

# --- Free-tier data keys (see docs/DATA_SOURCES.md for how to get each) ---
CLOUDFLARE_RADAR_TOKEN=
OPENPAGERANK_API_KEY=
PAGESPEED_API_KEY=
YOUTUBE_API_KEY=
FB_AD_LIBRARY_TOKEN=
